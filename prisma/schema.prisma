generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  SUPPORT
  PRODUCT_EDITOR // can add and edit products only
}

enum InquiryStatus {
  new
  contacted
  confirmed
  delivered
  cancelled
  closed // legacy: pre-promo "closed" rows; not settable any more
}

enum InquirySource {
  website
  admin
}

enum AttributionSource {
  code // customer typed / arrived with the code
  phone // same customer phone used a code within the attribution window
}

enum DiscountType {
  PERCENT
  FIXED
}

enum CommissionStatus {
  pending // sale confirmed, waiting for delivery + hold period
  approved // ready to pay
  paid
  void
}

enum CustomerConfirmation {
  confirmed // customer confirmed they did NOT buy
  disputed // customer says they DID buy
}

enum DisputeSource {
  marketer
  customer
}

enum DisputeStatus {
  open
  accepted
  rejected
}

enum CancelReason {
  no_answer
  changed_mind
  price
  out_of_stock
  duplicate
  returned
  other
}

enum NotificationDeliveryStatus {
  pending
  sending
  sent
  failed
}

enum MediaType {
  image
  video
}

enum AdPlacement {
  home_hero
  home_strip
  category_top
}

enum ProductCurrency {
  ETB
  USD
}

enum ProductSizeType {
  NONE
  SHOE_EU
  CLOTHING
  CUSTOM
}

model User {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String           @unique
  passwordHash String           @map("password_hash")
  role         UserRole         @default(ADMIN)
  isActive     Boolean          @default(true) @map("is_active")
  lastLoginAt  DateTime?        @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions     RefreshSession[]

  @@map("users")
}

model RefreshSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}

model Category {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId       String?         @map("parent_id") @db.Uuid
  slug           String          @unique
  nameEn         String          @map("name_en")
  nameAm         String?         @map("name_am")
  nameOr         String?         @map("name_or")
  imageUrl       String?         @map("image_url")
  sortOrder      Int             @default(0) @map("sort_order")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent         Category?       @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children       Category[]      @relation("CategoryTree")
  products       Product[]
  advertisements Advertisement[]

  @@index([parentId, sortOrder])
  @@map("categories")
}

model ProductFamily {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String    @unique
  brand       String
  modelCode   String    @map("model_code")
  displayName String    @map("display_name")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  products    Product[]

  @@index([brand])
  @@map("product_families")
}

model Product {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String          @unique
  name           String
  productType    String          @default("Product") @map("product_type")
  nameAm         String?         @map("name_am")
  nameOr         String?         @map("name_or")
  description    String
  descriptionAm  String?         @map("description_am")
  descriptionOr  String?         @map("description_or")
  categoryId     String?         @map("category_id") @db.Uuid
  categoryLegacy String?         @map("category")
  brand          String?
  familyId       String?         @map("family_id") @db.Uuid
  colorName      String?         @map("color_name")
  colorCode      String?         @map("color_code")
  colorHex       String?         @map("color_hex")
  variantKey     String?         @map("variant_key")
  variantSort    Int             @default(0) @map("variant_sort_order")
  price          Decimal?        @db.Decimal(10, 2)
  wasPrice       Decimal?        @map("was_price") @db.Decimal(10, 2)
  /// Flash deal: a lower price that only applies between flashStartsAt (or now) and flashEndsAt.
  flashPrice     Decimal?        @map("flash_price") @db.Decimal(10, 2)
  flashStartsAt  DateTime?       @map("flash_starts_at") @db.Timestamptz(6)
  flashEndsAt    DateTime?       @map("flash_ends_at") @db.Timestamptz(6)
  currency       ProductCurrency @default(ETB)
  sizeType       ProductSizeType @default(NONE) @map("size_type")
  sizes          String[]        @default([])
  images         String[]        @default([])
  imageViews     Json            @default("[]") @map("image_views")
  inStock        Boolean         @default(true) @map("in_stock")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  family         ProductFamily?  @relation(fields: [familyId], references: [id], onDelete: SetNull)
  inquiries      Inquiry[]

  @@unique([familyId, variantKey])
  @@index([categoryId, createdAt(sort: Desc)])
  @@index([brand])
  @@index([inStock, createdAt(sort: Desc)])
  @@index([flashEndsAt])
  @@map("products")
}

model Inquiry {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String?       @map("product_id") @db.Uuid
  productName   String        @map("product_name")
  fullName      String        @map("full_name")
  phone         String
  /// Last 9 digits of the phone, used to match the same customer across inquiries.
  phoneKey      String?       @map("phone_key")
  telegram      String
  selectedSize  String?       @map("selected_size")
  selectedColor String?       @map("selected_color")
  message       String?
  status        InquiryStatus @default(new)
  source        InquirySource @default(website)
  quantity      Int           @default(1)

  // Promo attribution + price snapshots taken when the inquiry was submitted.
  promoCodeId       String?            @map("promo_code_id") @db.Uuid
  promoCodeText     String?            @map("promo_code_text")
  attributionSource AttributionSource? @map("attribution_source")
  listPrice         Decimal?           @map("list_price") @db.Decimal(10, 2)
  discountAmount    Decimal?           @map("discount_amount") @db.Decimal(10, 2)
  quotedPrice       Decimal?           @map("quoted_price") @db.Decimal(10, 2)
  currency          ProductCurrency?
  /// Commission per item snapshotted from the promo code when attributed.
  commissionPerItem Decimal?           @map("commission_per_item") @db.Decimal(10, 2)

  // Outcome
  finalAmount  Decimal?      @map("final_amount") @db.Decimal(10, 2)
  cancelReason CancelReason? @map("cancel_reason")
  cancelNote   String?       @map("cancel_note")
  confirmedAt  DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  deliveredAt  DateTime?     @map("delivered_at") @db.Timestamptz(6)
  cancelledAt  DateTime?     @map("cancelled_at") @db.Timestamptz(6)

  // Customer Telegram link (bot deep link) + their answer when cancelled.
  customerLinkCode     String?               @unique @map("customer_link_code")
  customerChatId       String?               @map("customer_chat_id")
  customerConfirmation CustomerConfirmation? @map("customer_confirmation")
  customerConfirmedAt  DateTime?             @map("customer_confirmed_at") @db.Timestamptz(6)

  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  product       Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  promoCode     PromoCode?            @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  notifications InquiryNotification[]
  commission    Commission?
  feedback      InquiryFeedback?
  disputes      Dispute[]

  @@index([status, createdAt(sort: Desc)])
  @@index([promoCodeId, createdAt(sort: Desc)])
  @@index([phoneKey, createdAt(sort: Desc)])
  @@map("inquiries")
}

model Marketer {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  phone            String
  phoneKey         String?      @map("phone_key")
  telegram         String?
  payoutMethod     String?      @map("payout_method")
  payoutAccount    String?      @map("payout_account")
  notes            String?
  isActive         Boolean      @default(true) @map("is_active")
  /// sha256 of the private portal token. The raw token is only shown to the admin once.
  portalTokenHash  String       @unique @map("portal_token_hash")
  telegramLinkCode String       @unique @map("telegram_link_code")
  telegramChatId   String?      @map("telegram_chat_id")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  promoCodes       PromoCode[]
  commissions      Commission[]
  payouts          Payout[]
  disputes         Dispute[]

  @@map("marketers")
}

model PromoCode {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String       @unique
  marketerId       String       @map("marketer_id") @db.Uuid
  discountType     DiscountType @map("discount_type")
  discountValue    Decimal      @map("discount_value") @db.Decimal(10, 2)
  /// Fixed commission (ETB) paid per item sold with this code.
  commissionAmount Decimal      @map("commission_amount") @db.Decimal(10, 2)
  startsAt         DateTime?    @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime?    @map("ends_at") @db.Timestamptz(6)
  maxUses          Int?         @map("max_uses")
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  marketer         Marketer     @relation(fields: [marketerId], references: [id], onDelete: Restrict)
  inquiries        Inquiry[]
  visits           PromoVisit[]

  @@index([marketerId])
  @@map("promo_codes")
}

model PromoVisit {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promoCodeId String    @map("promo_code_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@index([promoCodeId, createdAt])
  @@map("promo_visits")
}

model Commission {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  marketerId String           @map("marketer_id") @db.Uuid
  inquiryId  String           @unique @map("inquiry_id") @db.Uuid
  amount     Decimal          @db.Decimal(10, 2)
  /// The amount without any dispute penalty, for transparency.
  baseAmount Decimal          @map("base_amount") @db.Decimal(10, 2)
  isPenalty  Boolean          @default(false) @map("is_penalty")
  status     CommissionStatus @default(pending)
  eligibleAt DateTime?        @map("eligible_at") @db.Timestamptz(6)
  voidReason String?          @map("void_reason")
  payoutId   String?          @map("payout_id") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  marketer   Marketer         @relation(fields: [marketerId], references: [id], onDelete: Restrict)
  inquiry    Inquiry          @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  payout     Payout?          @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@index([marketerId, status])
  @@index([status, eligibleAt])
  @@map("commissions")
}

model Payout {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  marketerId     String       @map("marketer_id") @db.Uuid
  amount         Decimal      @db.Decimal(10, 2)
  method         String
  transactionRef String       @map("transaction_ref")
  receiptUrl     String?      @map("receipt_url")
  note           String?
  paidAt         DateTime     @default(now()) @map("paid_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  marketer       Marketer     @relation(fields: [marketerId], references: [id], onDelete: Restrict)
  commissions    Commission[]

  @@index([marketerId, paidAt(sort: Desc)])
  @@map("payouts")
}

model Dispute {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inquiryId     String        @map("inquiry_id") @db.Uuid
  marketerId    String        @map("marketer_id") @db.Uuid
  source        DisputeSource
  note          String?
  status        DisputeStatus @default(open)
  adminResponse String?       @map("admin_response")
  resolvedAt    DateTime?     @map("resolved_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  inquiry       Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  marketer      Marketer      @relation(fields: [marketerId], references: [id], onDelete: Restrict)

  @@index([status, createdAt(sort: Desc)])
  @@index([marketerId, createdAt(sort: Desc)])
  @@map("disputes")
}

/// Append-only history. Never updated or deleted by the application.
model AuditEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity     String // inquiry | commission | promo_code | marketer | payout | dispute
  entityId   String   @map("entity_id") @db.Uuid
  marketerId String?  @map("marketer_id") @db.Uuid
  action     String
  detail     Json     @default("{}")
  actor      String // "admin:<email>" | "system" | "customer" | "marketer"
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entity, entityId, createdAt])
  @@index([marketerId, createdAt(sort: Desc)])
  @@map("audit_events")
}

/// Generic outbound Telegram queue (marketer + customer messages).
model TelegramOutbox {
  id            String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatId        String                     @map("chat_id")
  text          String
  replyMarkup   Json?                      @map("reply_markup")
  status        NotificationDeliveryStatus @default(pending)
  attempts      Int                        @default(0)
  nextAttemptAt DateTime                   @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lockedAt      DateTime?                  @map("locked_at") @db.Timestamptz(6)
  lastError     String?                    @map("last_error")
  sentAt        DateTime?                  @map("sent_at") @db.Timestamptz(6)
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@map("telegram_outbox")
}

model InquiryNotification {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inquiryId         String                     @map("inquiry_id") @db.Uuid
  channel           String                     @default("telegram")
  status            NotificationDeliveryStatus @default(pending)
  attempts          Int                        @default(0)
  nextAttemptAt     DateTime                   @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lockedAt          DateTime?                  @map("locked_at") @db.Timestamptz(6)
  providerMessageId String?                    @map("provider_message_id")
  lastError         String?                    @map("last_error")
  sentAt            DateTime?                  @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  inquiry           Inquiry                    @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@unique([inquiryId, channel])
  @@index([status, nextAttemptAt])
  @@map("inquiry_notifications")
}

model Advertisement {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String
  mediaUrl   String      @map("media_url")
  mediaType  MediaType   @default(image) @map("media_type")
  posterUrl  String?     @map("poster_url")
  linkUrl    String?     @map("link_url")
  placement  AdPlacement
  categoryId String?     @map("category_id") @db.Uuid
  sortOrder  Int         @default(0) @map("sort_order")
  isActive   Boolean     @default(true) @map("is_active")
  startsAt   DateTime?   @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime?   @map("ends_at") @db.Timestamptz(6)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([placement, isActive, sortOrder])
  @@index([categoryId])
  @@map("advertisements")
}

/// Optional rating/comment a customer leaves right after sending an inquiry.
model InquiryFeedback {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inquiryId   String   @unique @map("inquiry_id") @db.Uuid
  rating      Int
  comment     String?
  /// Customer agreed that the review may be shown publicly on the website.
  allowPublic Boolean  @default(false) @map("allow_public")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  inquiry     Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@map("inquiry_feedback")
}
