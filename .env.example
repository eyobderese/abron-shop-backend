NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://abron:abron@localhost:5432/abron_shop?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-seeding

# Uploaded media is stored on the local server filesystem.
MEDIA_PUBLIC_URL=http://localhost:3000/uploads
MEDIA_LOCAL_DIR=uploads
IMAGE_MAX_DIMENSION=1600
IMAGE_WEBP_QUALITY=82

# Optional: enables admin-generated Amharic and Afaan Oromo translation drafts.
GOOGLE_TRANSLATE_API_KEY=replace-with-a-restricted-google-translation-api-key

# Optional: send a Telegram message to the administrator for each new inquiry.
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_ADMIN_CHAT_ID=replace-with-your-private-chat-id
TELEGRAM_ADMIN_URL=http://localhost:5173/admin/inquiries
